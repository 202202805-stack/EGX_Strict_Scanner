class SuppressStdOut:
    def __enter__(self):
        self._original_stderr = sys.stderr
        self.devnull = open(os.devnull, 'w')
        sys.stderr = self.devnull
    def __exit__(self, exc_type, exc_val, exc_tb):
        self.devnull.close()
        sys.stderr = self._original_stderr

def send_telegram_message(message):
    """ إرسال الإشعارات إلى التلجرام """
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        print("⚠️ لم يتم ضبط TELEGRAM_BOT_TOKEN أو TELEGRAM_CHAT_ID في متغيرات البيئة.")
        return
    
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": message,
        "parse_mode": "Markdown"
    }
    try:
        response = requests.post(url, json=payload, timeout=10)
        if response.status_code == 200:
            print("✅ تم إرسال التقرير إلى Telegram بنجاح.")
        else:
            print(f"❌ فشل إرسال التلجرام: {response.text}")
    except Exception as e:
        print(f"⚠️ خطأ أثناء الاتصال بـ Telegram: {e}")

def find_steel_supports_optimized(df):
    lows = df['low'].values
    highs = df['high'].values
    opens = df['open'].values
    closes = df['close'].values
    segments = df['segment'].values
    pivots = []
    
    for i in range(LOOKBACK, len(lows) - LOOKBACK):
        if lows[i] == min(lows[i-LOOKBACK : i+LOOKBACK+1]):
            pivots.append({'index': i, 'price': lows[i], 'segment': segments[i]})
    
    steel_levels = []
    for i in range(len(pivots)):
        for j in range(i):
            p1, p2 = pivots[j], pivots[i]
            
            if p1['segment'] != p2['segment']:
                continue
                
            price_diff = abs(p1['price'] - p2['price']) / p1['price']
            time_diff = p2['index'] - p1['index']
            
            if price_diff <= SENSITIVITY and time_diff >= MIN_DAYS_GAP:
                inter_opens = opens[p1['index'] + 1 : p2['index']]
                inter_closes = closes[p1['index'] + 1 : p2['index']]
                inter_bodies_low = np.minimum(inter_opens, inter_closes)
                
                support_level = p1['price']
                
                if len(inter_bodies_low) > 0 and np.any(inter_bodies_low < support_level):
                    continue
                
                inter_high = max(highs[p1['index'] : p2['index']])
                rejection = (inter_high - p1['price']) / p1['price']
                
                if rejection >= REJECTION_POWER:
                    steel_levels.append({
                        'price': p2['price'], 
                        'active_from_idx': p2['index'], 
                        'segment': p2['segment']
                    })
                    break
    return steel_levels

def scan_single_stock(ticker):
    """ فحص السهم للبحث عن إشارة دخول جديدة في آخر يوم تداول فقط """
    try:
        with SuppressStdOut():
            ticker_obj = yf.Ticker(ticker)
            splits = ticker_obj.splits
            # كافي سحب آخر سنة لمعرفة الدعوم وتوليد الإشارات الحالية
            df = yf.download(ticker, period="1y", interval="1d", progress=False, auto_adjust=True)
            
        if df.empty or len(df) < 50: return None
        
        if isinstance(df.columns, pd.MultiIndex): 
            df.columns = df.columns.get_level_values(0)
            
        df.columns = [c.lower() for c in df.columns]
        df.index = pd.to_datetime(df.index).date

        df["segment"] = 0
        if not splits.empty:
            split_dates = pd.to_datetime(splits.index).date
            segment = 0
            for d in split_dates:
                segment += 1
                df.loc[df.index >= d, "segment"] = segment
        
        lows, closes, opens = df['low'].values, df['close'].values, df['open'].values
        dates = df.index
        
        all_steel_levels = find_steel_supports_optimized(df)
        
        # نتحقق فقط من الشمعة الأخيرة (اليوم الحقيقي للـ Scanner)
        last_idx = len(df) - 1
        
        available_supports = [
            l for l in all_steel_levels 
            if l['active_from_idx'] <= last_idx and l['segment'] == df['segment'].iloc[last_idx]
        ]

        for support in available_supports:
            lvl = support['price']
            upper_bound = lvl * 1.01
            lower_bound = lvl * 0.99
            
            yesterday_body_low = min(opens[last_idx-1], closes[last_idx-1])
            was_above = yesterday_body_low > upper_bound
            opened_above = opens[last_idx] >= lower_bound
            
            if was_above and opened_above:
                if lows[last_idx] <= upper_bound and lows[last_idx] >= lower_bound:
                    
                    # الفلتر الصارم لإغلاق يوم اللمس
                    if (closes[last_idx] - lvl) / lvl > MAX_ENTRY_SLIPPAGE:
                        continue 
                    
                    dist_percent = ((closes[last_idx] - lvl) / lvl) * 100
                    
                    return {
                        'Ticker': ticker.replace('.CA', ''),
                        'Support_Price': round(lvl, 3),
                        'Close_Price': round(closes[last_idx], 3),
                        'Distance_%': round(dist_percent, 2),
                        'Date': dates[last_idx]
                    }

    except Exception: pass
    return None

def run_daily_scanner():
    print(f"[{datetime.now().strftime('%H:%M:%S')}] 🚀 بدء الفحص اليومي للأسهم المصرية...")
    
    signals = []
    with ProcessPoolExecutor() as executor:
        futures = {executor.submit(scan_single_stock, ticker): ticker for ticker in egyptian_stocks}
        for future in as_completed(futures):
            res = future.result()
            if res:
                signals.append(res)

    # بناء رسالة التلجرام
    today_str = datetime.now().strftime('%Y-%m-%d')
    message = f"📊 *تقرير سكانر الأسهم المصرية (EGX)*\n📅 *التاريخ:* `{today_str}`\n"
    message += "─" * 28 + "\n\n"

    if signals:
        message += f"🎯 *تم العثور على ({len(signals)}) فرصة شراء عند الدعم:*\n\n"
        for sig in signals:
            message += f"🔹 *السهم:* `{sig['Ticker']}`\n"
            message += f"   • سعر الدعم: `{sig['Support_Price']}` جم\n"
            message += f"   • سعر الإغلاق: `{sig['Close_Price']}` جم\n"
            message += f"   • الابتعاد عن الدعم: `{sig['Distance_%']}%`\n"
            message += "🏼" + "─"*15 + "\n"
    else:
        message += "⚠️ *لا توجد أسهم ملامسة لمستويات الدعم المطابقة للشروط اليوم.*"

    print(message)
    send_telegram_message(message)

if __name__ == "__main__":
    run_daily_scanner()
