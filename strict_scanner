class SuppressStdOut:
    def __enter__(self):
        self._original_stderr = sys.stderr
        self.devnull = open(os.devnull, 'w')
        sys.stderr = self.devnull
    def __exit__(self, exc_type, exc_val, exc_tb):
        self.devnull.close()
        sys.stderr = self._original_stderr

def send_telegram_notification(message):
    """ إرسال نص الرسالة فقط إلى التلجرام """
    if not TELEGRAM_BOT_TOKEN or not TELEGRAM_CHAT_ID:
        print("⚠️ لم يتم العثور على بيانات TELEGRAM_TOKEN أو TELEGRAM_CHAT_ID.")
        return

    url_msg = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {"chat_id": TELEGRAM_CHAT_ID, "text": message, "parse_mode": "Markdown"}
    try:
        response = requests.post(url_msg, json=payload, timeout=15)
        if response.status_code == 200:
            print("✅ تم إرسال الصفقات المفتوحة إلى التلجرام بنجاح.")
        else:
            print(f"❌ فشل الإرسال: {response.text}")
    except Exception as e:
        print(f"❌ خطأ إرسال نص التلجرام: {e}")

def find_steel_supports_optimized(df):
    lows = df['low'].values
    highs = df['high'].values
    opens = df['open'].values
    closes = df['close'].values
    segments = df['segment'].values
    pivots = []
    
    for i in range(LOOKBACK, len(lows) - LOOKBACK):
        if lows[i] == min(lows[i-LOOKBACK : i+LOOKBACK+1]):
            pivots.append({'index': i, 'price': lows[i], 'segment': segments[i]})
    
    steel_levels = []
    for i in range(len(pivots)):
        for j in range(i):
            p1, p2 = pivots[j], pivots[i]
            
            if p1['segment'] != p2['segment']:
                continue
                
            price_diff = abs(p1['price'] - p2['price']) / p1['price']
            time_diff = p2['index'] - p1['index']
            
            if price_diff <= SENSITIVITY and time_diff >= MIN_DAYS_GAP:
                inter_opens = opens[p1['index'] + 1 : p2['index']]
                inter_closes = closes[p1['index'] + 1 : p2['index']]
                inter_bodies_low = np.minimum(inter_opens, inter_closes)
                
                support_level = p1['price']
                
                if len(inter_bodies_low) > 0 and np.any(inter_bodies_low < support_level):
                    continue
                
                inter_high = max(highs[p1['index'] : p2['index']])
                rejection = (inter_high - p1['price']) / p1['price']
                
                if rejection >= REJECTION_POWER:
                    steel_levels.append({
                        'price': p2['price'], 
                        'active_from_idx': p2['index'], 
                        'segment': p2['segment']
                    })
                    break
    return steel_levels

def process_stock(ticker, start_dt, end_dt):
    trades = []
    try:
        with SuppressStdOut():
            ticker_obj = yf.Ticker(ticker)
            splits = ticker_obj.splits
            df = yf.download(ticker, start=start_dt, end=end_dt, interval="1d", progress=False, auto_adjust=True)
            
        if df.empty or len(df) < 50: return trades
        
        if isinstance(df.columns, pd.MultiIndex): 
            df.columns = df.columns.get_level_values(0)
            
        df.columns = [c.lower() for c in df.columns]
        df.index = pd.to_datetime(df.index).date

        df["segment"] = 0
        if not splits.empty:
            split_dates = pd.to_datetime(splits.index).date
            segment = 0
            for d in split_dates:
                segment += 1
                df.loc[df.index >= d, "segment"] = segment
        
        lows, highs, closes, opens = df['low'].values, df['high'].values, df['close'].values, df['open'].values
        dates = df.index
        
        all_steel_levels = find_steel_supports_optimized(df)
        
        in_pos = False
        entry_p, entry_d, entry_day_close = 0, None, 0
        cooldown_until_idx = -1 

        for i in range(20, len(df)):
            if not in_pos:
                if i < cooldown_until_idx: continue

                available_supports = [
                    l for l in all_steel_levels 
                    if l['active_from_idx'] <= i and l['segment'] == df['segment'].iloc[i]
                ]

                for support in available_supports:
                    lvl = support['price']
                    upper_bound = lvl * 1.01
                    lower_bound = lvl * 0.99
                    
                    yesterday_body_low = min(opens[i-1], closes[i-1])
                    was_above = yesterday_body_low > upper_bound
                    opened_above = opens[i] >= lower_bound
                    
                    if was_above and opened_above:
                        if lows[i] <= upper_bound and lows[i] >= lower_bound:
                            
                            if (closes[i] - lvl) / lvl > MAX_ENTRY_SLIPPAGE:
                                continue 
                            
                            entry_p = lvl 
                            entry_d = dates[i]
                            entry_day_close = closes[i]
                            in_pos = True
                            break 
            
            else:
                target = entry_day_close * (1 + TARGET_PROFIT)
                stop = entry_p * (1 - STOP_LOSS)
                
                if highs[i] >= target:
                    in_pos, cooldown_until_idx = False, i + 14
                
                elif lows[i] <= stop:
                    in_pos, cooldown_until_idx = False, i + 1
                
                elif i == len(df) - 1:
                    current_return = ((closes[i] - entry_day_close) / entry_day_close) * 100
                    trades.append({
                        'Ticker': ticker.replace('.CA', ''), 
                        'Status': 'Open ⏳', 
                        'Entry Price': round(entry_p, 3), 
                        'Entry Day Close': round(entry_day_close, 3), 
                        'Current Price': round(closes[i], 3),
                        'Return': f"{current_return:.2f}%", 
                        'Entry Date': entry_d, 
                        'Days Held': (dates[i] - entry_d).days
                    })

    except Exception: pass
    return trades

def run_comprehensive_backtest():
    end_date = datetime.now()
    start_date = end_date - timedelta(days=10 * 365)
    
    start_str = start_date.strftime('%Y-%m-%d')
    end_str = end_date.strftime('%Y-%m-%d')

    print(f"[{datetime.now().strftime('%H:%M:%S')}] 🚀 تشغيل الفحص واستخراج الصفقات المفتوحة...")
    
    open_trades = []
    with ProcessPoolExecutor() as executor:
        futures = {executor.submit(process_stock, ticker, start_str, end_str): ticker for ticker in egyptian_stocks}
        for future in as_completed(futures):
            res = future.result()
            if res: open_trades.extend(res)

    today_str = datetime.now().strftime('%Y-%m-%d')
    msg = f"📊 *تقرير الصفقات المفتوحة حالياً (EGX)*\n📅 *التاريخ:* `{today_str}`\n"
    msg += "─" * 30 + "\n\n"

    if open_trades:
        msg += f"⏳ *تم العثور على ({len(open_trades)}) صفقة مفتوحة ومستمرة:*\n\n"
        for row in open_trades:
            dist = ((row['Current Price'] - row['Entry Price']) / row['Entry Price']) * 100
            msg += f"🔹 *السهم:* `{row['Ticker']}`\n"
            msg += f"   • تاريخ الدخول: `{row['Entry Date']}`\n"
            msg += f"   • سعر الدعم: `{row['Entry Price']}` جم\n"
            msg += f"   • سعر الإغلاق الحالي: `{row['Current Price']}` جم\n"
            msg += f"   • المسافة عن الدعم: `{dist:.2f}%`\n"
            msg += f"   • العائد الحلي: `{row['Return']}`\n"
            msg += f"   • أيام الاحتفاظ: `{row['Days Held']}` يوم\n"
            msg += "─" * 18 + "\n"
    else:
        msg += "⚠️ *لا توجد صفقات مفتوحة حالياً مطابقة للشروط.*"

    # إرسال الرسالة فقط
    send_telegram_notification(msg)

if __name__ == "__main__":
    run_comprehensive_backtest()
